#!/bin/sh

exec >/dev/null 2>&1

[ -n "$TMUX" ] && [ -n "$TMUX_PANE" ] || exit 0

case $0 in
/*) self=$0 ;;
*) self=$PWD/$0 ;;
esac

suffix=' (#{?@agent_title,#{@agent_title} ,}waiting...)'
title='#{?#{m/r:^[^A-Za-z0-9 ]+ ,#{pane_title}},#{s/^[^A-Za-z0-9 ]+ //:pane_title},}'
shells='^-?(ba|da|fi|k|tc|z|c)?sh$'
quiet='#{e|>:#{e|-:#{T:@agent_now},#{pane_last_output_time}},15}'
condition="#{?#{&&:#{m/r:$shells,#{pane_current_command}},#{!=:#{pane_current_command},#{@agent_command}}},gone,#{?$quiet,quiet,live}}"

inspect() {
    { read -r window waiting working labelled owner since state; read -r automatic_rename; } <<EOF
$(tmux display-message -p -t "$TMUX_PANE" \
    "#{window_id} #{?@agent_waiting,1,0} #{?@agent_working,1,0} #{?@agent_label,1,0} #{==:#{pane_id},#{@agent_pane}} #{?pane_last_output_time,#{pane_last_output_time},0} $condition" \; \
    show-options -wv -t "$TMUX_PANE" automatic-rename)
EOF
    [ -n "$window" ]
}

adopt() {
    tmux set-option -w -t "$TMUX_PANE" @agent_pane "$TMUX_PANE" \; \
        set-option -w -F -t "$TMUX_PANE" @agent_command '#{pane_current_command}' \; \
        set-hook -p -t "$TMUX_PANE" -B "@agent-watch:$TMUX_PANE:$condition" \
            "run-shell -b \"TMUX_PANE=#{hook_pane} '$self' observe #{hook_value}\""
}

release() {
    tmux set-hook -p -t "$1" -u -B "@agent-watch:$1:"
    tmux set-hook -p -t "$1" -u @agent-watch
}

start_waiting() {
    tmux set-option -w -o -t "$window" @agent_waiting "$1" \; \
        set-option -w -F -t "$window" @agent_name '#{window_name}' \; \
        set-option -w -u -t "$window" @agent_working \; \
        set-option -w -F -t "$TMUX_PANE" @agent_title "$title" \; \
        set-option -w -t "$window" @agent_auto "${automatic_rename:-inherit}" \; \
        set-option -w -t "$window" @agent_label "$2" \; \
        rename-window -t "$window" "#{window_name}$suffix" && adopt
}

clear_waiting() {
    read -r window waiting untouched suffixed agent automatic_rename <<EOF
$(tmux display-message -p -t "$TMUX_PANE" \
    "#{window_id} #{?@agent_waiting,1,0} #{==:#{window_name},#{@agent_name}$suffix} #{==:#{=/-#{w:$suffix}:window_name},$suffix} #{?@agent_pane,#{@agent_pane},-} #{@agent_auto}")
EOF
    [ -n "$window" ] && [ "$waiting" = 1 ] || return 0

    set -- show-options -w -t "$window" @agent_waiting
    if [ "$untouched" = 1 ]; then
        set -- "$@" ';' rename-window -t "$window" '#{@agent_name}'
        case $automatic_rename in
        on) set -- "$@" ';' set-option -w -t "$window" automatic-rename on ;;
        inherit) set -- "$@" ';' set-option -w -u -t "$window" automatic-rename ;;
        esac
    elif [ "$suffixed" = 1 ]; then
        set -- "$@" ';' rename-window -t "$window" "#{=/#{e|-:#{w:window_name},#{w:$suffix}}:window_name}"
    fi
    tmux "$@" ';' \
        set-option -w -u -t "$window" @agent_waiting ';' \
        set-option -w -u -t "$window" @agent_name ';' \
        set-option -w -u -t "$window" @agent_title ';' \
        set-option -w -u -t "$window" @agent_auto ';' \
        set-option -w -u -t "$window" @agent_label
}

forget() {
    clear_waiting
    tmux set-option -w -u -t "$TMUX_PANE" @agent_working \; \
        set-option -w -u -t "$TMUX_PANE" @agent_title \; \
        set-option -w -u -t "$TMUX_PANE" @agent_pane \; \
        set-option -w -u -t "$TMUX_PANE" @agent_command
    release "$TMUX_PANE"
    [ "$agent" = - ] || [ "$agent" = "$TMUX_PANE" ] || release "$agent"
}

announce() {
    front=$(lsappinfo info -only pid "$(lsappinfo front)" |
        sed -n 's/.*pid"\{0,1\} *= *\([0-9]\{1,\}\).*/\1/p' | head -n 1)

    tmux list-clients -F '#{client_name} #{client_pid} #{window_id}' | while read -r client process shown; do
        tmux display-message -c "$client" -t "$window" -d 5000 \
            '#{q/h:@agent_label} waiting: #{q/h:session_name} › #{q/h:@agent_name}'
        [ -c "$client" ] || continue
        if [ "$shown" = "$window" ]; then
            while [ "${process:-0}" -gt 1 ] && [ "$process" != "${front:-$process}" ]; do
                process=$(ps -o ppid= -p "$process" | tr -d ' ')
            done
            [ "${process:-0}" -gt 1 ] && continue
        fi
        printf '\a' >"$client"
    done
}

case $1 in
waiting)
    inspect || exit 0
    if [ "$waiting" = 0 ]; then
        start_waiting "$(date +%s)" "${2:-Agent}" || exit 0
    elif [ "$labelled" = 0 ]; then
        tmux set-option -w -t "$window" @agent_label "${2:-Agent}"
    else
        exit 0
    fi
    announce
    ;;
working)
    clear_waiting
    tmux set-option -w -F -t "$TMUX_PANE" @agent_working "#{?@agent_working,#{@agent_working},$(date +%s)}" \; \
        set-option -w -F -t "$TMUX_PANE" @agent_title "$title" && adopt
    ;;
clear)
    forget
    ;;
observe)
    [ "$2" != quiet ] || sleep 2
    inspect || exit 0
    if [ "$owner" = 0 ]; then
        release "$TMUX_PANE"
    elif [ "$state" = gone ]; then
        forget
    elif [ "$state" = quiet ] && [ "$working" = 1 ]; then
        start_waiting "$since" ''
    fi
    ;;
sessions)
    client=$2
    tab=$(printf '\t')
    unit=$(printf '\037')
    leave="if -F -t $TMUX_PANE '##{==:##{pane_mode},tree-mode}' 'send-keys -t $TMUX_PANE q'"

    read -r height total current <<EOF
$(tmux display-message -p -c "$client" -t "$TMUX_PANE" '#{client_height} #{server_sessions} #{session_id}')
EOF
    [ -n "$current" ] || exit 0

    rows=$(tmux list-sessions -O index \
        -F "#{W:#{?@agent_waiting,#{@agent_waiting} #{@agent_title}$unit,}}$tab#{W:#{?@agent_working,#{@agent_working} #{@agent_title}$unit,}}$tab#{session_id}$tab#{?session_attached,(attached),}$tab#{session_name}" |
        awk -F '\t' -v now="$(date +%s)" -v unit="$unit" '
            function earliest(field, entries, count, start) {
                since = 0
                title = ""
                for (count = split(field, entries, unit); count > 0; count--) {
                    start = entries[count] + 0
                    if (start && (!since || start < since)) {
                        since = start
                        title = entries[count]
                        sub(/^[0-9]+ /, "", title)
                    }
                }
                gsub(/#/, "##", title)
                return since
            }
            {
                name = $5
                gsub(/#/, "##", name)
                row = (name ~ /^-/ ? "#[default]" : "") name
                notes = $4
                if (earliest($1)) {
                    group = 0
                    minutes = int((now - since) / 60)
                    age = minutes < 60 ? minutes "m" : sprintf("%dh%02dm", minutes / 60, minutes % 60)
                    notes = (notes ? notes " " : "") "#[fg=themeblack,bg=darkorange](" (title ? title " " : "") "waiting " age ")"
                } else if (earliest($2)) {
                    group = 1
                    notes = (notes ? notes " " : "") "#[fg=themeblack,bg=themegreen](" (title ? title " " : "") "working...)"
                } else {
                    group = 2
                    since = NR
                }
                if (notes)
                    row = row "  #[align=right]" notes
                printf "%d\t%d\t%s\t%s\n", group, since, $3, row
            }
        ' | sort -k 1,1n -k 2,2n)

    capacity=$((height - 5))
    gaps=$(printf '%s\n' "$rows" | awk -F '\t' '$1 != last { groups++; last = $1 } END { print groups - 1 }')
    [ $((total + gaps)) -le "$capacity" ] || capacity=$((capacity - 1))

    set --
    lines=0
    listed=0
    waiting=0
    previous=
    choice=0
    while IFS=$tab read -r group _ session name; do
        gap=0
        [ -z "$previous" ] || [ "$group" = "$previous" ] || gap=1
        [ $((lines + gap)) -lt "$capacity" ] || break
        if [ "$gap" = 1 ]; then
            set -- "$@" ''
            lines=$((lines + 1))
        fi
        previous=$group
        if [ "$group" = 0 ]; then
            waiting=1
        elif [ "$waiting" = 0 ] && [ "$session" = "$current" ]; then
            choice=$lines
        fi
        set -- "$@" "$name" '' "$leave ; switch-client -t '$session'"
        lines=$((lines + 1))
        listed=$((listed + 1))
    done <<EOF
$rows
EOF
    set -- "$@" ''
    [ "$listed" = "$total" ] || set -- "$@" 'All sessions' '' ''
    set -- "$@" 'Close' q "$leave"

    tmux display-menu -c "$client" -t "$TMUX_PANE" -C "$choice" -T ' Sessions ' -x C -y C "$@"
    ;;
esac

exit 0
