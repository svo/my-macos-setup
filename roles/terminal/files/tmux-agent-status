#!/bin/sh

exec >/dev/null 2>&1

[ -n "$TMUX" ] && [ -n "$TMUX_PANE" ] || exit 0

case $1 in
waiting)
    label=${2:-Agent}

    { read -r window waiting; read -r automatic_rename; } <<EOF
$(tmux display-message -p -t "$TMUX_PANE" '#{window_id} #{?@agent_waiting,1,0}' \; \
    show-options -wv -t "$TMUX_PANE" automatic-rename)
EOF
    [ -n "$window" ] && [ "$waiting" = 0 ] || exit 0

    tmux set-option -w -o -t "$window" @agent_waiting 1 \; \
        set-option -w -F -t "$window" @agent_name '#{window_name}' \; \
        set-option -w -t "$window" @agent_auto "${automatic_rename:-inherit}" \; \
        set-option -w -t "$window" @agent_label "$label" \; \
        rename-window -t "$window" '#{window_name} (waiting...)' || exit 0

    tmux list-clients -F '#{client_name}' | while IFS= read -r client; do
        tmux display-message -c "$client" -t "$window" -d 5000 \
            '#{q/h:@agent_label} waiting: #{q/h:session_name} › #{q/h:@agent_name}'
    done
    ;;
clear)
    read -r window waiting untouched suffixed automatic_rename <<EOF
$(tmux display-message -p -t "$TMUX_PANE" \
    '#{window_id} #{?@agent_waiting,1,0} #{==:#{window_name},#{@agent_name} (waiting...)} #{m:* (waiting...),#{window_name}} #{@agent_auto}')
EOF
    [ -n "$window" ] && [ "$waiting" = 1 ] || exit 0

    set -- show-options -w -t "$window" @agent_waiting
    if [ "$untouched" = 1 ]; then
        set -- "$@" ';' rename-window -t "$window" '#{@agent_name}'
        case $automatic_rename in
        on) set -- "$@" ';' set-option -w -t "$window" automatic-rename on ;;
        inherit) set -- "$@" ';' set-option -w -u -t "$window" automatic-rename ;;
        esac
    elif [ "$suffixed" = 1 ]; then
        set -- "$@" ';' rename-window -t "$window" '#{s/ \(waiting\.\.\.\)$//:window_name}'
    fi
    tmux "$@" ';' \
        set-option -w -u -t "$window" @agent_waiting ';' \
        set-option -w -u -t "$window" @agent_name ';' \
        set-option -w -u -t "$window" @agent_auto ';' \
        set-option -w -u -t "$window" @agent_label
    ;;
esac

exit 0
